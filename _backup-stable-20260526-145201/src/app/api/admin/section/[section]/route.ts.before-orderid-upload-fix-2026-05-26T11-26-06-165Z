
import { NextResponse } from "next/server";
import { getAdminSupabase, verifyAdminToken } from "@/lib/vemoAdminServer";

const sectionConfig: Record<string, { table: string }> = {
  clients: { table: "client_accounts" },
  dossiers: { table: "client_orders" },
  paiements: { table: "client_payments" },
  documents: { table: "client_documents" },
  messages: { table: "client_messages" },
};

function cleanEmail(value: unknown) {
  return String(value || "").trim().toLowerCase();
}

function isUuid(value: string) {
  return /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(value);
}

function safeFileName(name: string) {
  return name
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-zA-Z0-9._-]+/g, "-")
    .replace(/-+/g, "-")
    .replace(/^-|-$/g, "")
    .toLowerCase();
}

async function validOrderId(orderId: string, clientEmail: string) {
  if (!orderId || !isUuid(orderId)) return null;

  const supabase = getAdminSupabase();
  if (!supabase) return null;

  const { data } = await supabase
    .from("client_orders")
    .select("id")
    .eq("id", orderId)
    .eq("client_email", clientEmail)
    .maybeSingle();

  return data?.id || null;
}

function applyFilters(query: any, section: string, url: URL) {
  const email = url.searchParams.get("email") || "";
  const orderId = url.searchParams.get("order_id") || "";

  if (email && section !== "clients") {
    query = query.eq("client_email", email.toLowerCase());
  }

  if (orderId && isUuid(orderId) && ["paiements", "documents", "messages"].includes(section)) {
    query = query.eq("order_id", orderId);
  }

  return query;
}

export async function GET(
  request: Request,
  context: { params: Promise<{ section: string }> }
) {
  const auth = verifyAdminToken(request);

  if (!auth.ok) {
    return NextResponse.json({ ok: false, message: auth.message }, { status: auth.status });
  }

  const { section } = await context.params;
  const config = sectionConfig[section];

  if (!config) {
    return NextResponse.json({ ok: false, rows: [], message: "Unknown section." }, { status: 404 });
  }

  const supabase = getAdminSupabase();

  if (!supabase) {
    return NextResponse.json({ ok: false, rows: [], message: "Supabase not configured." }, { status: 500 });
  }

  const url = new URL(request.url);

  let query = supabase
    .from(config.table)
    .select("*")
    .order("created_at", { ascending: false })
    .limit(300);

  query = applyFilters(query, section, url);

  const { data, error } = await query;

  return NextResponse.json({
    ok: !error,
    section,
    table: config.table,
    rows: data || [],
    warning: error?.message || "",
  });
}

export async function PATCH(
  request: Request,
  context: { params: Promise<{ section: string }> }
) {
  const auth = verifyAdminToken(request);

  if (!auth.ok) {
    return NextResponse.json({ ok: false, message: auth.message }, { status: auth.status });
  }

  const { section } = await context.params;
  const config = sectionConfig[section];

  if (!config) {
    return NextResponse.json({ ok: false, message: "Unknown section." }, { status: 404 });
  }

  const supabase = getAdminSupabase();

  if (!supabase) {
    return NextResponse.json({ ok: false, message: "Supabase not configured." }, { status: 500 });
  }

  const body = await request.json().catch(() => ({}));
  const id = String(body?.id || "");

  if (!id) {
    return NextResponse.json({ ok: false, message: "Missing id." }, { status: 400 });
  }

  const payload: Record<string, unknown> = {
    updated_at: new Date().toISOString(),
  };

  if (section === "clients") {
    payload.portal_enabled = true;
    payload.status = "active";
  }

  if (section === "dossiers") {
    payload.status = String(body?.status || "in_progress");
  }

  if (section === "paiements") {
    payload.status = "verified";
    payload.payment_status = "verified";
    payload.verified_at = new Date().toISOString();
    payload.verified_by = "admin";
  }

  if (section === "documents") {
    payload.status = "approved";
    payload.approved_at = new Date().toISOString();
    payload.approved_by = "admin";
  }

  if (section === "messages") {
    payload.status = "closed";
    payload.is_read = true;
    payload.closed_at = new Date().toISOString();
    payload.closed_by = "admin";
  }

  const { error } = await supabase
    .from(config.table)
    .update(payload)
    .eq("id", id);

  if (error) {
    return NextResponse.json({ ok: false, message: error.message }, { status: 400 });
  }

  return NextResponse.json({ ok: true });
}

export async function POST(
  request: Request,
  context: { params: Promise<{ section: string }> }
) {
  const auth = verifyAdminToken(request);

  if (!auth.ok) {
    return NextResponse.json({ ok: false, message: auth.message }, { status: auth.status });
  }

  const { section } = await context.params;

  if (!sectionConfig[section]) {
    return NextResponse.json({ ok: false, message: "Unknown section." }, { status: 404 });
  }

  const supabase = getAdminSupabase();

  if (!supabase) {
    return NextResponse.json({ ok: false, message: "Supabase not configured." }, { status: 500 });
  }

  if (section === "documents") {
    const form = await request.formData();

    const clientEmail = cleanEmail(form.get("client_email"));
    const rawOrderId = String(form.get("order_id") || "").trim();
    const title = String(form.get("title") || "").trim();
    const documentType = String(form.get("document_type") || "general").trim();
    const notes = String(form.get("notes") || "").trim();
    const file = form.get("file");

    if (!clientEmail) {
      return NextResponse.json({ ok: false, message: "Client email is required." }, { status: 400 });
    }

    if (!title) {
      return NextResponse.json({ ok: false, message: "Document title is required." }, { status: 400 });
    }

    if (!(file instanceof File)) {
      return NextResponse.json({ ok: false, message: "File is required." }, { status: 400 });
    }

    const orderId = await validOrderId(rawOrderId, clientEmail);
    const originalName = safeFileName(file.name || "document.pdf");
    const storagePath = [
      clientEmail,
      orderId || "general",
      Date.now() + "-" + originalName,
    ].join("/");

    const buffer = Buffer.from(await file.arrayBuffer());

    const upload = await supabase.storage
      .from("client-documents")
      .upload(storagePath, buffer, {
        contentType: file.type || "application/octet-stream",
        upsert: false,
      });

    if (upload.error) {
      return NextResponse.json({ ok: false, message: upload.error.message }, { status: 400 });
    }

    const { data, error } = await supabase
      .from("client_documents")
      .insert({
        client_email: clientEmail,
        order_id: orderId,
        document_type: documentType,
        title,
        file_name: file.name || originalName,
        file_path: storagePath,
        file_url: "",
        mime_type: file.type || "application/octet-stream",
        size_bytes: file.size || null,
        status: "available",
        uploaded_by: "admin",
        notes,
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString(),
      })
      .select("*")
      .single();

    if (error) {
      await supabase.storage.from("client-documents").remove([storagePath]);
      return NextResponse.json({ ok: false, message: error.message }, { status: 400 });
    }

    return NextResponse.json({ ok: true, row: data });
  }

  if (section === "messages") {
    const body = await request.json().catch(() => ({}));
    const clientEmail = cleanEmail(body?.client_email);

    if (!clientEmail) {
      return NextResponse.json({ ok: false, message: "Client email is required." }, { status: 400 });
    }

    const orderId = await validOrderId(String(body?.order_id || ""), clientEmail);

    const { data, error } = await supabase
      .from("client_messages")
      .insert({
        client_email: clientEmail,
        order_id: orderId,
        sender: "admin",
        subject: String(body?.subject || "Message Vemo"),
        message: String(body?.message || ""),
        status: "sent",
        is_read: false,
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString(),
      })
      .select("*")
      .single();

    if (error) {
      return NextResponse.json({ ok: false, message: error.message }, { status: 400 });
    }

    return NextResponse.json({ ok: true, row: data });
  }

  return NextResponse.json({ ok: false, message: "Create action not available for this section." }, { status: 400 });
}

export async function DELETE(
  request: Request,
  context: { params: Promise<{ section: string }> }
) {
  const auth = verifyAdminToken(request);

  if (!auth.ok) {
    return NextResponse.json({ ok: false, message: auth.message }, { status: auth.status });
  }

  const { section } = await context.params;
  const config = sectionConfig[section];

  if (!config) {
    return NextResponse.json({ ok: false, message: "Unknown section." }, { status: 404 });
  }

  if (!["documents", "messages"].includes(section)) {
    return NextResponse.json({ ok: false, message: "Delete action not available." }, { status: 400 });
  }

  const supabase = getAdminSupabase();

  if (!supabase) {
    return NextResponse.json({ ok: false, message: "Supabase not configured." }, { status: 500 });
  }

  const url = new URL(request.url);
  const id = url.searchParams.get("id") || "";

  if (!id) {
    return NextResponse.json({ ok: false, message: "Missing id." }, { status: 400 });
  }

  if (section === "documents") {
    const { data: doc } = await supabase
      .from("client_documents")
      .select("file_path")
      .eq("id", id)
      .maybeSingle();

    if (doc?.file_path) {
      await supabase.storage.from("client-documents").remove([doc.file_path]);
    }
  }

  const { error } = await supabase
    .from(config.table)
    .delete()
    .eq("id", id);

  if (error) {
    return NextResponse.json({ ok: false, message: error.message }, { status: 400 });
  }

  return NextResponse.json({ ok: true });
}
