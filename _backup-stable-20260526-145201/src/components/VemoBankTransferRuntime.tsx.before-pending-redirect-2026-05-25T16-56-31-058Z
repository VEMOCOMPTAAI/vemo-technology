  `;

  document.body.appendChild(overlay);

  const close = () => overlay.remove();

  overlay.querySelector("#vemo-themed-notice-close")?.addEventListener("click", close);
  overlay.addEventListener("click", (event) => {
    if (event.target === overlay) close();
  });
}

function normalizeText(value: string) {
  return value
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/\s+/g, " ")
    .trim();
}

function isBankSelected() {
  const selects = Array.from(document.querySelectorAll("select")) as HTMLSelectElement[];

  for (const select of selects) {
    const selectedText = normalizeText(select.options[select.selectedIndex]?.text || "");
    const selectedValue = normalizeText(select.value || "");

    if (
      selectedText.includes("virement") ||
      selectedText.includes("bank transfer") ||
      selectedValue.includes("bank")
    ) {
      return true;
    }
  }

  return false;
}

function findBankCard() {
  const all = Array.from(document.querySelectorAll("div, section, article")) as HTMLElement[];

  const title = all.find((el) => {
    const text = normalizeText(el.innerText || "");
    return text === "virement bancaire" || text === "bank transfer";
  });

  if (!title) return null;

  let card: HTMLElement | null = title;

  for (let i = 0; i < 8; i++) {
    if (!card?.parentElement) break;
    card = card.parentElement as HTMLElement;

    const text = normalizeText(card.innerText || "");
    const rect = card.getBoundingClientRect();

    if (
      text.includes("virement bancaire") &&
      rect.width > 350 &&
      rect.height > 80
    ) {
      return card;
    }

    if (
      text.includes("bank transfer") &&
      rect.width > 350 &&
      rect.height > 80
    ) {
      return card;
    }
  }

  return null;
}

