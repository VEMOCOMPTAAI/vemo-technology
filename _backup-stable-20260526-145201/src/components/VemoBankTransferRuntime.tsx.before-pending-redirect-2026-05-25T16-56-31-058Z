      <button id="vemo-themed-notice-close" type="button" style="
        margin-top:24px;
        width:100%;
        height:52px;
        border:0;
        border-radius:10px;
        background:#F15A24;
        color:white;
        font-size:14px;
        font-weight:900;
        cursor:pointer;
        box-shadow:0 14px 28px rgba(241,90,36,.20);
