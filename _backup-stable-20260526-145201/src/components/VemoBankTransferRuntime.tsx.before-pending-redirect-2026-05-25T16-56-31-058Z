function enhanceBankTransfer() {
  if (!isBankSelected()) return;

  const card = findBankCard();
  if (!card) return;

  if (card.querySelector("#vemo-bank-transfer-forced-ui")) return;

  const lang = window.location.pathname.startsWith("/fr") ? "fr" : "en";

  // Masquer les faux champs vides créés par les anciens patchs
  const children = Array.from(card.children) as HTMLElement[];
  for (const child of children) {
    const text = normalizeText(child.innerText || "");
    const rect = child.getBoundingClientRect();

    if (!text && rect.height < 80) {
      child.style.display = "none";
    }
  }

  const wrapper = document.createElement("div");
  wrapper.innerHTML = buildBankTransferHtml(lang);
  card.appendChild(wrapper.firstElementChild as HTMLElement);

  const fileInput = card.querySelector("#vemo-bank-file") as HTMLInputElement | null;
  const selectedFile = card.querySelector("#vemo-bank-selected-file") as HTMLElement | null;
  const fileLabel = card.querySelector("#vemo-bank-file-label") as HTMLElement | null;

  fileInput?.addEventListener("change", () => {
    const fileName = fileInput.files?.[0]?.name || "";

    if (fileName && selectedFile && fileLabel) {
      fileLabel.textContent = fileName.length > 22 ? fileName.slice(0, 19) + "..." : fileName;
      selectedFile.style.display = "block";
      selectedFile.textContent =
        lang === "fr"
          ? "Fichier sélectionné : " + fileName
          : "Selected file: " + fileName;
    }
  });

  const submit = card.querySelector("#vemo-bank-submit") as HTMLButtonElement | null;

  submit?.addEventListener("click", () => {
    const allButtons = Array.from(document.querySelectorAll("button")) as HTMLButtonElement[];

    const existingSubmit = allButtons.find((btn) => {
      if (btn.id === "vemo-bank-submit") return false;
      const text = normalizeText(btn.innerText || "");
      return (
        text.includes("valider") ||
        text.includes("creer mon compte") ||
        text.includes("create my account") ||
        text.includes("validate")
      );
    });

    if (existingSubmit && !existingSubmit.disabled) {
      existingSubmit.click();
      return;
    }

    showVemoNotice(
      lang === "fr"
        ? "Justificatif ajouté. Vous pouvez maintenant valider votre dossier."
        : "Payment proof added. You can now validate your case.",
      "success"
    );
  });
}

export default function VemoBankTransferRuntime() {
  useEffect(() => {
    enhanceBankTransfer();

    const observer = new MutationObserver(() => {
      enhanceBankTransfer();
    });

    observer.observe(document.body, {
      childList: true,
      subtree: true,
      characterData: true,
    });

    document.addEventListener("change", enhanceBankTransfer);
    document.addEventListener("click", () => setTimeout(enhanceBankTransfer, 80));

    return () => {
      observer.disconnect();
      document.removeEventListener("change", enhanceBankTransfer);
    };
  }, []);

  return null;
}
