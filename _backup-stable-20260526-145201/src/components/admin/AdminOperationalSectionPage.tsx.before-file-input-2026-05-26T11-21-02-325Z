
"use client";

import { useEffect, useMemo, useState } from "react";
import { AdminShell } from "@/components/admin/AdminShell";

type Lang = "fr" | "en";
type Section = "clients" | "dossiers" | "paiements" | "documents" | "messages";
type Row = Record<string, any>;

const labels: Record<Section, Record<Lang, string>> = {
  clients: { fr: "Clients", en: "Clients" },
  dossiers: { fr: "Dossiers", en: "Cases" },
  paiements: { fr: "Paiements", en: "Payments" },
  documents: { fr: "Documents", en: "Documents" },
  messages: { fr: "Messages", en: "Messages" },
};

function formatDate(value: any) {
  if (!value) return "-";

  const date = new Date(String(value));

  if (Number.isNaN(date.getTime())) return "-";

  return new Intl.DateTimeFormat("fr-FR", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  }).format(date);
}

function displayValue(value: any) {
  if (value === null || value === undefined || value === "") return "-";
  if (typeof value === "boolean") return value ? "Oui" : "Non";

  if (typeof value === "object") {
    try {
      return JSON.stringify(value);
    } catch {
      return "-";
    }
  }

  return String(value);
}

function pick(row: Row, keys: string[]) {
  for (const key of keys) {
    if (row[key] !== undefined && row[key] !== null && row[key] !== "") {
      return row[key];
    }
  }

  return "";
}

function statusLabel(status: string, isFr: boolean) {
  const s = String(status || "").toLowerCase();

  const map: Record<string, string> = {
    active: isFr ? "Actif" : "Active",
    pending_activation: isFr ? "Activation en attente" : "Pending activation",
    in_progress: isFr ? "En cours" : "In progress",
    pending: isFr ? "En attente" : "Pending",
    pending_verification: isFr ? "À vérifier" : "To verify",
    verified: isFr ? "Vérifié" : "Verified",
    approved: isFr ? "Approuvé" : "Approved",
    available: isFr ? "Disponible" : "Available",
    open: isFr ? "Ouvert" : "Open",
    sent: isFr ? "Envoyé" : "Sent",
    closed: isFr ? "Traité" : "Closed",
  };

  return map[s] || status || "-";
}

function getStoredSelection() {
  if (typeof window === "undefined") {
    return { email: "", orderId: "", clientName: "", packageName: "" };
  }

  return {
    email: localStorage.getItem("vemo_admin_selected_client_email") || "",
    orderId: localStorage.getItem("vemo_admin_selected_order_id") || "",
    clientName: localStorage.getItem("vemo_admin_selected_client_name") || "",
    packageName: localStorage.getItem("vemo_admin_selected_package_name") || "",
  };
}

function saveSelection(row: Row) {
  const email = String(pick(row, ["client_email", "email", "billing_email"]) || "").toLowerCase();
  const orderId = String(row.id || row.order_id || "");
  const clientName = String(pick(row, ["client_name", "full_name", "name"]) || "");
  const packageName = String(pick(row, ["package_name", "title"]) || "");

  if (email) localStorage.setItem("vemo_admin_selected_client_email", email);
  if (orderId) localStorage.setItem("vemo_admin_selected_order_id", orderId);
  if (clientName) localStorage.setItem("vemo_admin_selected_client_name", clientName);
  if (packageName) localStorage.setItem("vemo_admin_selected_package_name", packageName);

  return {
    email,
    orderId,
    clientName,
    packageName,
  };
}

export default function AdminOperationalSectionPage({
  lang,
  section,
}: {
  lang: Lang;
  section: Section;
}) {
  const isFr = lang === "fr";
  const title = labels[section]?.[lang] || section;

  const [rows, setRows] = useState<Row[]>([]);
  const [warning, setWarning] = useState("");
  const [loading, setLoading] = useState(true);
  const [actionMessage, setActionMessage] = useState("");

  const [selected, setSelected] = useState({
    email: "",
    orderId: "",
    clientName: "",
    packageName: "",
  });

  const [docTitle, setDocTitle] = useState("");
  const [docType, setDocType] = useState("general");
  const [docUrl, setDocUrl] = useState("");
  const [docNotes, setDocNotes] = useState("");

  const [msgSubject, setMsgSubject] = useState("");
  const [msgBody, setMsgBody] = useState("");

  const mustHaveSelection = ["paiements", "documents", "messages"].includes(section);

  function clearSelection() {
    localStorage.removeItem("vemo_admin_selected_client_email");
    localStorage.removeItem("vemo_admin_selected_order_id");
    localStorage.removeItem("vemo_admin_selected_client_name");
    localStorage.removeItem("vemo_admin_selected_package_name");

    setSelected({
      email: "",
      orderId: "",
      clientName: "",
      packageName: "",
    });

    setRows([]);
  }

  async function load() {
    setLoading(true);
    setWarning("");
    setActionMessage("");

    const stored = getStoredSelection();
    setSelected(stored);

    if (mustHaveSelection && !stored.email) {
      setRows([]);
      setLoading(false);
      setWarning(
        isFr
          ? "Sélectionnez d’abord un client ou ouvrez un dossier. Ensuite, seuls ses paiements, documents et messages seront affichés."
          : "Select a client or open a case first. Then only related payments, documents and messages will be shown."
      );
      return;
    }

    try {
      const token = localStorage.getItem("vemo_admin_session") || "";

      const params = new URLSearchParams();

      if (section !== "clients" && stored.email) {
        params.set("email", stored.email);
      }

      if (["paiements", "documents", "messages"].includes(section) && stored.orderId) {
        params.set("order_id", stored.orderId);
      }

      const url = "/api/admin/section/" + section + (params.toString() ? "?" + params.toString() : "");

      const response = await fetch(url, {
        headers: {
          "x-vemo-admin-session": token,
        },
      });

      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        setWarning(data?.message || "Erreur admin.");
        setRows([]);
        setLoading(false);
        return;
      }

      setRows(Array.isArray(data.rows) ? data.rows : []);
      setWarning(data.warning || "");
      setLoading(false);
    } catch {
      setWarning(isFr ? "Impossible de charger les données." : "Unable to load data.");
      setRows([]);
      setLoading(false);
    }
  }

  async function applyAction(row: Row) {
    setActionMessage("");

    if (section === "clients" || section === "dossiers") {
      const saved = saveSelection(row);
      setSelected(saved);
      setActionMessage(
        isFr
          ? "Client sélectionné. Vous pouvez maintenant ouvrir ses paiements, documents et messages."
          : "Client selected. You can now open related payments, documents and messages."
      );

      if (section === "dossiers") {
        window.location.href = lang === "fr" ? "/fr/admin/documents" : "/en/admin/documents";
      }

      return;
    }

    const id = row.id;

    if (!id) {
      setActionMessage(isFr ? "ID introuvable pour cette ligne." : "Missing row ID.");
      return;
    }

    try {
      const token = localStorage.getItem("vemo_admin_session") || "";

      const response = await fetch("/api/admin/section/" + section, {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
          "x-vemo-admin-session": token,
        },
        body: JSON.stringify({ id }),
      });

      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        setActionMessage(data?.message || "Action impossible.");
        return;
      }

      setActionMessage(isFr ? "Action enregistrée avec succès." : "Action saved successfully.");
      await load();
    } catch {
      setActionMessage(isFr ? "Action impossible pour le moment." : "Action unavailable for now.");
    }
  }

  async function addDocument() {
    if (!selected.email) {
      setActionMessage(isFr ? "Sélectionnez d’abord un client." : "Select a client first.");
      return;
    }

    if (!docTitle.trim()) {
      setActionMessage(isFr ? "Le titre du document est obligatoire." : "Document title is required.");
      return;
    }

    try {
      const token = localStorage.getItem("vemo_admin_session") || "";

      const response = await fetch("/api/admin/section/documents", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-vemo-admin-session": token,
        },
        body: JSON.stringify({
          client_email: selected.email,
          order_id: selected.orderId || null,
          title: docTitle.trim(),
          file_name: docTitle.trim(),
          document_type: docType,
          file_url: docUrl.trim(),
          notes: docNotes.trim(),
          status: "available",
        }),
      });

      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        setActionMessage(data?.message || "Ajout impossible.");
        return;
      }

      setDocTitle("");
      setDocType("general");
      setDocUrl("");
      setDocNotes("");
      setActionMessage(isFr ? "Document ajouté à l’espace client." : "Document added to client portal.");
      await load();
    } catch {
      setActionMessage(isFr ? "Ajout impossible pour le moment." : "Unable to add document.");
    }
  }

  async function sendMessage() {
    if (!selected.email) {
      setActionMessage(isFr ? "Sélectionnez d’abord un client." : "Select a client first.");
      return;
    }

    if (!msgBody.trim()) {
      setActionMessage(isFr ? "Le message est obligatoire." : "Message is required.");
      return;
    }

    try {
      const token = localStorage.getItem("vemo_admin_session") || "";

      const response = await fetch("/api/admin/section/messages", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-vemo-admin-session": token,
        },
        body: JSON.stringify({
          client_email: selected.email,
          order_id: selected.orderId || null,
          subject: msgSubject.trim() || "Message Vemo",
          message: msgBody.trim(),
        }),
      });

      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        setActionMessage(data?.message || "Envoi impossible.");
        return;
      }

      setMsgSubject("");
      setMsgBody("");
      setActionMessage(isFr ? "Message envoyé au client." : "Message sent to client.");
      await load();
    } catch {
      setActionMessage(isFr ? "Envoi impossible pour le moment." : "Unable to send message.");
    }
  }

  async function deleteRow(row: Row) {
    const id = row.id;

    if (!id) return;

    const ok = window.confirm(isFr ? "Supprimer cet élément ?" : "Delete this item?");

    if (!ok) return;

    try {
      const token = localStorage.getItem("vemo_admin_session") || "";

      const response = await fetch("/api/admin/section/" + section + "?id=" + encodeURIComponent(id), {
        method: "DELETE",
        headers: {
          "x-vemo-admin-session": token,
        },
      });

      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        setActionMessage(data?.message || "Suppression impossible.");
        return;
      }

      setActionMessage(isFr ? "Élément supprimé." : "Item deleted.");
      await load();
    } catch {
      setActionMessage(isFr ? "Suppression impossible." : "Delete failed.");
    }
  }

  useEffect(() => {
    load();
  }, [section]);

  const actionLabel =
    section === "clients"
      ? isFr ? "Sélectionner" : "Select"
      : section === "dossiers"
        ? isFr ? "Ouvrir" : "Open"
        : section === "paiements"
          ? isFr ? "Vérifier" : "Verify"
          : section === "documents"
            ? isFr ? "Approuver" : "Approve"
            : isFr ? "Traité" : "Close";

  return (
    <AdminShell lang={lang}>
      <div className="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <div className="inline-flex rounded-md bg-white px-4 py-2 text-xs font-black uppercase tracking-[0.18em] text-[#123A63] shadow-sm ring-1 ring-[#E8E2DC]">
            Admin
          </div>

          <h2 className="mt-5 text-5xl font-black leading-[1.05] tracking-[-0.06em] text-[#2B2F36]">
            {title}
          </h2>

          <p className="mt-4 max-w-2xl text-sm font-semibold leading-7 text-[#2B2F36]/68">
            {section === "clients" && (isFr ? "Sélectionnez un client pour consulter ses dossiers, paiements, documents et messages." : "Select a client to view related cases, payments, documents and messages.")}
            {section === "dossiers" && (isFr ? "Ouvrez un dossier pour filtrer automatiquement les pages documents, paiements et messages." : "Open a case to automatically filter documents, payments and messages.")}
            {section === "paiements" && (isFr ? "Paiements du client ou dossier sélectionné uniquement." : "Payments for the selected client or case only.")}
            {section === "documents" && (isFr ? "Documents du client ou dossier sélectionné uniquement." : "Documents for the selected client or case only.")}
            {section === "messages" && (isFr ? "Messages du client ou dossier sélectionné uniquement." : "Messages for the selected client or case only.")}
          </p>
        </div>

        <button
          type="button"
          onClick={load}
          className="h-12 rounded-[8px] bg-[#F15A24] px-6 text-sm font-black text-white shadow-[0_14px_28px_rgba(241,90,36,0.20)]"
        >
          {isFr ? "Actualiser" : "Refresh"}
        </button>
      </div>

      <SelectedClientBox selected={selected} isFr={isFr} onClear={clearSelection} />

      {section === "documents" && selected.email ? (
        <section className="mt-6 rounded-[16px] border border-[#E8E2DC] bg-white p-6 shadow-[0_18px_45px_rgba(43,47,54,0.06)]">
          <div className="text-xs font-black uppercase tracking-[0.18em] text-[#F15A24]">
            {isFr ? "Ajouter un document" : "Add document"}
          </div>

          <div className="mt-5 grid gap-4 md:grid-cols-4">
            <input
              value={docTitle}
              onChange={(e) => setDocTitle(e.target.value)}
              placeholder={isFr ? "Titre du document" : "Document title"}
              className="h-12 rounded-[10px] border border-[#E8E2DC] bg-white px-4 text-sm font-bold outline-none focus:border-[#F15A24]"
            />

            <select
              value={docType}
              onChange={(e) => setDocType(e.target.value)}
              className="h-12 rounded-[10px] border border-[#E8E2DC] bg-white px-4 text-sm font-bold outline-none focus:border-[#F15A24]"
            >
              <option value="general">General</option>
              <option value="ein_letter">EIN Letter</option>
              <option value="operating_agreement">Operating Agreement</option>
              <option value="company_document">Company Document</option>
              <option value="payment_proof">Justificatif paiement</option>
            </select>

            <input
              value={docUrl}
              onChange={(e) => setDocUrl(e.target.value)}
              placeholder="URL fichier optionnelle"
              className="h-12 rounded-[10px] border border-[#E8E2DC] bg-white px-4 text-sm font-bold outline-none focus:border-[#F15A24]"
            />

            <button
              type="button"
              onClick={addDocument}
              className="h-12 rounded-[8px] bg-[#F15A24] px-5 text-sm font-black text-white"
            >
              {isFr ? "Ajouter" : "Add"}
            </button>
          </div>

          <textarea
            value={docNotes}
            onChange={(e) => setDocNotes(e.target.value)}
            placeholder={isFr ? "Notes internes optionnelles" : "Optional internal notes"}
            className="mt-4 min-h-[90px] w-full rounded-[10px] border border-[#E8E2DC] bg-white px-4 py-3 text-sm font-bold outline-none focus:border-[#F15A24]"
          />
        </section>
      ) : null}

      {section === "messages" && selected.email ? (
        <section className="mt-6 rounded-[16px] border border-[#E8E2DC] bg-white p-6 shadow-[0_18px_45px_rgba(43,47,54,0.06)]">
          <div className="text-xs font-black uppercase tracking-[0.18em] text-[#F15A24]">
            {isFr ? "Envoyer un message au client" : "Send message to client"}
          </div>

          <input
            value={msgSubject}
            onChange={(e) => setMsgSubject(e.target.value)}
            placeholder={isFr ? "Objet du message" : "Subject"}
            className="mt-5 h-12 w-full rounded-[10px] border border-[#E8E2DC] bg-white px-4 text-sm font-bold outline-none focus:border-[#F15A24]"
          />

          <textarea
            value={msgBody}
            onChange={(e) => setMsgBody(e.target.value)}
            placeholder={isFr ? "Votre message..." : "Your message..."}
            className="mt-4 min-h-[120px] w-full rounded-[10px] border border-[#E8E2DC] bg-white px-4 py-3 text-sm font-bold outline-none focus:border-[#F15A24]"
          />

          <button
            type="button"
            onClick={sendMessage}
            className="mt-4 h-12 rounded-[8px] bg-[#F15A24] px-6 text-sm font-black text-white"
          >
            {isFr ? "Envoyer" : "Send"}
          </button>
        </section>
      ) : null}

      {warning ? (
        <div className="mt-6 rounded-[12px] border border-orange-200 bg-[#FFF7F1] px-5 py-4 text-sm font-bold leading-7 text-[#123A63]">
          {warning}
        </div>
      ) : null}

      {actionMessage ? (
        <div className="mt-5 rounded-[12px] border border-orange-200 bg-white px-5 py-4 text-sm font-bold leading-7 text-[#123A63]">
          {actionMessage}
        </div>
      ) : null}

      <section className="mt-8 overflow-hidden rounded-[16px] border border-[#E8E2DC] bg-white shadow-[0_24px_70px_rgba(43,47,54,0.08)]">
        {loading ? (
          <div className="p-8 text-sm font-black text-[#123A63]">
            {isFr ? "Chargement..." : "Loading..."}
          </div>
        ) : rows.length === 0 ? (
          <div className="p-8">
            <div className="text-xs font-black uppercase tracking-[0.18em] text-[#F15A24]">
              {isFr ? "Aucune donnée" : "No data"}
            </div>
            <h3 className="mt-3 text-3xl font-black tracking-[-0.05em] text-[#2B2F36]">
              {mustHaveSelection && !selected.email
                ? isFr ? "Aucun client sélectionné." : "No client selected."
                : isFr ? "Aucun élément à afficher." : "Nothing to display."}
            </h3>
          </div>
        ) : (
          <div className="overflow-auto">
            <table className="w-full min-w-[980px] text-left text-sm">
              <thead className="bg-[#FFF7F1] text-xs font-black uppercase tracking-[0.14em] text-[#123A63]">
                <tr>
                  <th className="px-5 py-4">Email</th>
                  <th className="px-5 py-4">Nom / Pack</th>
                  <th className="px-5 py-4">Statut</th>
                  <th className="px-5 py-4">Date</th>
                  <th className="px-5 py-4">Détails</th>
                  <th className="px-5 py-4 text-right">Action</th>
                </tr>
              </thead>

              <tbody>
                {rows.map((row, index) => {
                  const email = displayValue(pick(row, ["email", "client_email", "billing_email"]));
                  const namePack = displayValue(
                    pick(row, ["client_name", "full_name", "name", "package_name", "title", "file_name", "filename", "subject"])
                  );
                  const status = statusLabel(String(pick(row, ["status", "payment_status", "portal_status"]) || ""), isFr);
                  const date = formatDate(pick(row, ["created_at", "updated_at", "paid_at"]));
                  const details = displayValue(
                    pick(row, ["notes", "message", "description", "amount", "document_type", "payment_method", "file_url"])
                  );

                  return (
                    <tr key={row.id || index} className="border-t border-[#E8E2DC]">
                      <td className="px-5 py-4 font-black text-[#2B2F36]">{email}</td>
                      <td className="px-5 py-4 font-bold text-[#2B2F36]/72">{namePack}</td>
                      <td className="px-5 py-4">
                        <span className="rounded-full bg-[#FFF7F1] px-3 py-1 text-xs font-black text-[#F15A24]">
                          {status}
                        </span>
                      </td>
                      <td className="px-5 py-4 font-bold text-[#2B2F36]/60">{date}</td>
                      <td className="max-w-[320px] px-5 py-4 font-semibold text-[#2B2F36]/62">
                        <div className="line-clamp-2">{details}</div>
                      </td>
                      <td className="px-5 py-4 text-right">
                        <div className="flex justify-end gap-2">
                          <button
                            type="button"
                            onClick={() => applyAction(row)}
                            className="rounded-[8px] bg-[#F15A24] px-4 py-2 text-xs font-black text-white shadow-[0_10px_20px_rgba(241,90,36,0.16)]"
                          >
                            {actionLabel}
                          </button>

                          {["documents", "messages"].includes(section) ? (
                            <button
                              type="button"
                              onClick={() => deleteRow(row)}
                              className="rounded-[8px] border border-[#E8E2DC] bg-white px-4 py-2 text-xs font-black text-[#2B2F36]"
                            >
                              {isFr ? "Supprimer" : "Delete"}
                            </button>
                          ) : null}
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </section>
    </AdminShell>
  );
}

function SelectedClientBox({
  selected,
  isFr,
  onClear,
}: {
  selected: { email: string; orderId: string; clientName: string; packageName: string };
  isFr: boolean;
  onClear: () => void;
}) {
  if (!selected.email) {
    return (
      <div className="mt-8 rounded-[14px] border border-[#E8E2DC] bg-white p-5 shadow-[0_18px_45px_rgba(43,47,54,0.06)]">
        <div className="text-xs font-black uppercase tracking-[0.18em] text-[#F15A24]">
          {isFr ? "Aucun client sélectionné" : "No selected client"}
        </div>
        <p className="mt-2 text-sm font-bold text-[#2B2F36]/65">
          {isFr
            ? "Commencez par ouvrir un dossier ou sélectionner un client."
            : "Start by opening a case or selecting a client."}
        </p>
      </div>
    );
  }

  return (
    <div className="mt-8 flex flex-col justify-between gap-4 rounded-[14px] border border-[#E8E2DC] bg-white p-5 shadow-[0_18px_45px_rgba(43,47,54,0.06)] md:flex-row md:items-center">
      <div>
        <div className="text-xs font-black uppercase tracking-[0.18em] text-[#F15A24]">
          {isFr ? "Client sélectionné" : "Selected client"}
        </div>

        <div className="mt-2 text-lg font-black text-[#2B2F36]">
          {selected.email}
        </div>

        <div className="mt-1 text-sm font-bold text-[#2B2F36]/60">
          {[selected.clientName, selected.packageName, selected.orderId ? "Dossier: " + selected.orderId.slice(0, 8) : ""]
            .filter(Boolean)
            .join(" · ")}
        </div>
      </div>

      <button
        type="button"
        onClick={onClear}
        className="h-11 rounded-[8px] border border-[#E8E2DC] bg-white px-5 text-sm font-black text-[#123A63]"
      >
        {isFr ? "Changer de client" : "Change client"}
      </button>
    </div>
  );
}
