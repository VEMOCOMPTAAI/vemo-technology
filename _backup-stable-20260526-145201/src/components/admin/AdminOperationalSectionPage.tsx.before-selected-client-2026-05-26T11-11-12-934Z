
"use client";

import { useEffect, useMemo, useState } from "react";
import { AdminShell } from "@/components/admin/AdminShell";

type Lang = "fr" | "en";

type Row = Record<string, any>;

const labels: Record<string, Record<string, string>> = {
  clients: {
    fr: "Clients",
    en: "Clients",
  },
  dossiers: {
    fr: "Dossiers",
    en: "Cases",
  },
  paiements: {
    fr: "Paiements",
    en: "Payments",
  },
  documents: {
    fr: "Documents",
    en: "Documents",
  },
  messages: {
    fr: "Messages",
    en: "Messages",
  },
};

function displayValue(value: any) {
  if (value === null || value === undefined || value === "") return "-";

  if (typeof value === "boolean") return value ? "Oui" : "Non";

  if (typeof value === "object") {
    try {
      return JSON.stringify(value);
    } catch {
      return "-";
    }
  }

  return String(value);
}

function pick(row: Row, keys: string[]) {
  for (const key of keys) {
    if (row[key] !== undefined && row[key] !== null && row[key] !== "") {
      return row[key];
    }
  }

  return "-";
}

export default function AdminOperationalSectionPage({
  lang,
  section,
}: {
  lang: Lang;
  section: "clients" | "dossiers" | "paiements" | "documents" | "messages";
}) {
  const isFr = lang === "fr";
  const title = labels[section]?.[lang] || section;

  const [rows, setRows] = useState<Row[]>([]);
  const [warning, setWarning] = useState("");
  const [loading, setLoading] = useState(true);
  const [actionMessage, setActionMessage] = useState("");

  const filteredRows = useMemo(() => rows, [rows]);

  async function load() {
    setLoading(true);
    setWarning("");
    setActionMessage("");

    try {
      const token = localStorage.getItem("vemo_admin_session") || "";

      const response = await fetch("/api/admin/section/" + section, {
        headers: {
          "x-vemo-admin-session": token,
        },
      });

      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        setWarning(data?.message || "Erreur admin.");
        setRows([]);
        setLoading(false);
        return;
      }

      setRows(Array.isArray(data.rows) ? data.rows : []);
      setWarning(data.warning || "");
      setLoading(false);
    } catch {
      setWarning(isFr ? "Impossible de charger les données." : "Unable to load data.");
      setRows([]);
      setLoading(false);
    }
  }

  async function applyAction(row: Row) {
    setActionMessage("");

    const id = row.id;

    if (!id) {
      setActionMessage(isFr ? "ID introuvable pour cette ligne." : "Missing row ID.");
      return;
    }

    try {
      const token = localStorage.getItem("vemo_admin_session") || "";

      const response = await fetch("/api/admin/section/" + section, {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
          "x-vemo-admin-session": token,
        },
        body: JSON.stringify({ id }),
      });

      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        setActionMessage(data?.message || "Action impossible.");
        return;
      }

      setActionMessage(isFr ? "Action enregistrée avec succès." : "Action saved successfully.");
      await load();
    } catch {
      setActionMessage(isFr ? "Action impossible pour le moment." : "Action unavailable for now.");
    }
  }

  useEffect(() => {
    load();
  }, [section]);

  const actionLabel =
    section === "paiements"
      ? isFr ? "Vérifier" : "Verify"
      : section === "documents"
        ? isFr ? "Approuver" : "Approve"
        : section === "messages"
          ? isFr ? "Traité" : "Close"
          : section === "clients"
            ? isFr ? "Activer" : "Activate"
            : isFr ? "Mettre à jour" : "Update";

  return (
    <AdminShell lang={lang}>
      <div className="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <div className="inline-flex rounded-md bg-white px-4 py-2 text-xs font-black uppercase tracking-[0.18em] text-[#123A63] shadow-sm ring-1 ring-[#E8E2DC]">
            Admin
          </div>

          <h2 className="mt-5 text-5xl font-black leading-[1.05] tracking-[-0.06em] text-[#2B2F36]">
            {title}
          </h2>

          <p className="mt-4 max-w-2xl text-sm font-semibold leading-7 text-[#2B2F36]/68">
            {section === "clients" && (isFr ? "Gestion des comptes clients et accès portail." : "Manage client accounts and portal access.")}
            {section === "dossiers" && (isFr ? "Suivi des dossiers LLC et avancement." : "Track LLC cases and progress.")}
            {section === "paiements" && (isFr ? "Vérification des paiements carte et virements." : "Verify card payments and bank transfers.")}
            {section === "documents" && (isFr ? "Contrôle des justificatifs et documents client." : "Review client proofs and documents.")}
            {section === "messages" && (isFr ? "Suivi et traitement des messages client." : "Track and close client messages.")}
          </p>
        </div>

        <button
          type="button"
          onClick={load}
          className="h-12 rounded-[8px] bg-[#F15A24] px-6 text-sm font-black text-white shadow-[0_14px_28px_rgba(241,90,36,0.20)]"
        >
          {isFr ? "Actualiser" : "Refresh"}
        </button>
      </div>

      {warning ? (
        <div className="mt-8 rounded-[12px] border border-orange-200 bg-[#FFF7F1] px-5 py-4 text-sm font-bold leading-7 text-[#123A63]">
          {isFr
            ? "Table Supabase non encore disponible ou politique RLS à vérifier : "
            : "Supabase table not available yet or RLS policy to check: "}
          {warning}
        </div>
      ) : null}

      {actionMessage ? (
        <div className="mt-5 rounded-[12px] border border-orange-200 bg-white px-5 py-4 text-sm font-bold leading-7 text-[#123A63]">
          {actionMessage}
        </div>
      ) : null}

      <section className="mt-8 overflow-hidden rounded-[16px] border border-[#E8E2DC] bg-white shadow-[0_24px_70px_rgba(43,47,54,0.08)]">
        {loading ? (
          <div className="p-8 text-sm font-black text-[#123A63]">
            {isFr ? "Chargement..." : "Loading..."}
          </div>
        ) : filteredRows.length === 0 ? (
          <div className="p-8">
            <div className="text-xs font-black uppercase tracking-[0.18em] text-[#F15A24]">
              {isFr ? "Aucune donnée" : "No data"}
            </div>
            <h3 className="mt-3 text-3xl font-black tracking-[-0.05em] text-[#2B2F36]">
              {isFr ? "Aucun élément à afficher." : "Nothing to display."}
            </h3>
            <p className="mt-3 max-w-2xl text-sm font-semibold leading-7 text-[#2B2F36]/68">
              {isFr
                ? "Dès que les clients, paiements, documents ou messages seront créés, ils apparaîtront ici."
                : "Clients, payments, documents or messages will appear here once created."}
            </p>
          </div>
        ) : (
          <div className="overflow-auto">
            <table className="w-full min-w-[920px] text-left text-sm">
              <thead className="bg-[#FFF7F1] text-xs font-black uppercase tracking-[0.14em] text-[#123A63]">
                <tr>
                  <th className="px-5 py-4">Email</th>
                  <th className="px-5 py-4">Nom / Pack</th>
                  <th className="px-5 py-4">Statut</th>
                  <th className="px-5 py-4">Date</th>
                  <th className="px-5 py-4">Détails</th>
                  <th className="px-5 py-4 text-right">Action</th>
                </tr>
              </thead>

              <tbody>
                {filteredRows.map((row, index) => (
                  <tr key={row.id || index} className="border-t border-[#E8E2DC]">
                    <td className="px-5 py-4 font-black text-[#2B2F36]">
                      {displayValue(pick(row, ["email", "client_email", "billing_email"]))}
                    </td>

                    <td className="px-5 py-4 font-bold text-[#2B2F36]/72">
                      {displayValue(pick(row, ["full_name", "name", "client_name", "package_name", "title", "file_name", "filename"]))}
                    </td>

                    <td className="px-5 py-4">
                      <span className="rounded-full bg-[#FFF7F1] px-3 py-1 text-xs font-black text-[#F15A24]">
                        {displayValue(pick(row, ["status", "payment_status", "portal_status"]))}
                      </span>
                    </td>

                    <td className="px-5 py-4 font-bold text-[#2B2F36]/60">
                      {displayValue(pick(row, ["created_at", "updated_at", "paid_at"]))}
                    </td>

                    <td className="max-w-[280px] px-5 py-4 font-semibold text-[#2B2F36]/62">
                      <div className="line-clamp-2">
                        {displayValue(pick(row, ["message", "description", "notes", "amount", "document_type", "payment_method"]))}
                      </div>
                    </td>

                    <td className="px-5 py-4 text-right">
                      <button
                        type="button"
                        onClick={() => applyAction(row)}
                        className="rounded-[8px] bg-[#F15A24] px-4 py-2 text-xs font-black text-white shadow-[0_10px_20px_rgba(241,90,36,0.16)]"
                      >
                        {actionLabel}
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>
    </AdminShell>
  );
}
